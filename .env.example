# PostgreSQL
DATABASE_URL=postgresql://glacis:glacis@localhost:5432/glacis

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# LLM mode: "openai" or "mock"
LLM_MODE=mock

# Dedup TTL in seconds (default 3600 = 1 hour)
DEDUP_TTL=3600

# Worker: LLM retry
MAX_RETRIES=3
JOB_TIMEOUT=60

# Worker: DB retry on transient OperationalError (delay doubles each attempt)
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=1.0

# Mock LLM simulation (only used when LLM_MODE=mock)
# Increase these to simulate realistic LLM latency and failure rates in dev.
MOCK_DELAY_MIN=0.0
MOCK_DELAY_MAX=0.0
MOCK_ERROR_RATE=0.0
